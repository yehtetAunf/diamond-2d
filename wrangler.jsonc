{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diamond-2d",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "."
  },
  "kv_namespaces": [
    {
      "binding": "DIAMOND_DATA",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
